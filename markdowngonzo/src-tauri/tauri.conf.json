{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markdowngonzo",
  "version": "1.0.0",
  "identifier": "com.columbiafoundry.markdowngonzo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkDownGonzo",
        "width": 1380,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "publisher": "Columbia Foundry LLC",
    "homepage": "https://github.com/gregoftheweb/MarkDownGonzo",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 Columbia Foundry LLC",
    "category": "Productivity",
    "shortDescription": "A focused, local-first Markdown editor",
    "longDescription": "Create and edit clean GitHub-Flavored Markdown using visual and raw editing modes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "desktopTemplate": "../packaging/linux/markdowngonzo.desktop",
        "files": {
          "/usr/share/metainfo/com.columbiafoundry.markdowngonzo.metainfo.xml": "../packaging/linux/com.columbiafoundry.markdowngonzo.metainfo.xml",
          "/usr/share/mime/packages/markdowngonzo.xml": "../packaging/linux/markdowngonzo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/markdowngonzo.desktop",
        "files": {
          "/usr/share/metainfo/com.columbiafoundry.markdowngonzo.metainfo.xml": "../packaging/linux/com.columbiafoundry.markdowngonzo.metainfo.xml",
          "/usr/share/mime/packages/markdowngonzo.xml": "../packaging/linux/markdowngonzo.xml"
        }
      }
    }
  }
}
