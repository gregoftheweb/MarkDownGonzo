{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDownGonzo",
  "version": "0.1.0",
  "identifier": "com.columbiafoundry.markdowngonzo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkDownGonzo",
        "width": 1380,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Productivity",
    "shortDescription": "A focused, local-first Markdown editor",
    "longDescription": "Create and edit clean GitHub-Flavored Markdown using visual and raw editing modes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
