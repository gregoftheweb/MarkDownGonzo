+// Patched (patches/@tiptap+markdown+*.patch): a soft-wrapped source line break (a plain
+// "\n", not an explicit hard break) must render as whitespace, not a literal line break,
+// per CommonMark and every HTML renderer's default whitespace handling. Upstream leaves it
+// embedded raw in the resulting text node, which the editor's contenteditable surface then
+// renders as a visible line break instead of collapsing. Collapse it to a single space here,
+// at the only two places marked "text" tokens become ProseMirror text nodes.
+function collapseSoftLineBreaks(text) {
+	return text.replace(/[ \t]*\n[ \t]*/g, " ");
